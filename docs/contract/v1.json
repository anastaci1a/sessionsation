{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anastaci1a/sessionsation/main/docs/contract/v1.json",
  "title": "sessionsation CLI v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Success"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "api_version",
        "ok",
        "error"
      ],
      "additionalProperties": true
    },
    "Success": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "result": {}
      },
      "required": [
        "api_version",
        "ok",
        "result"
      ],
      "additionalProperties": true
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "host": {
          "enum": [
            "tmux",
            "herdr"
          ]
        },
        "target": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "process_start": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "target",
        "pid",
        "process_start"
      ],
      "additionalProperties": true
    },
    "Session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attachment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Attachment"
            }
          ]
        },
        "availability": {
          "enum": [
            "running",
            "saved",
            "unavailable",
            "archived"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "rename": {
              "type": "boolean"
            },
            "resume": {
              "type": "boolean"
            },
            "switch_account": {
              "type": "boolean"
            },
            "restart": {
              "type": "boolean"
            },
            "stop": {
              "type": "boolean"
            },
            "move_space": {
              "type": "boolean"
            }
          },
          "required": [
            "rename",
            "resume",
            "switch_account",
            "restart",
            "stop"
          ],
          "additionalProperties": true
        },
        "conversation_created_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "Native conversation timestamp when recorded; never filesystem mtime."
        },
        "history_file_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Bytes in the observed saved rollout, excluding shared account databases."
        },
        "resume_block_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Observed resume gate; unfinished_history is an explicit-confirmation warning. Consumers tolerate future codes."
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "description": "Positively observed working directory; null when the source cannot currently be observed."
        },
        "archive": {
          "$ref": "#/$defs/ArchiveMetadata"
        },
        "archived": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "account",
        "account_id",
        "conversation_id",
        "revision",
        "generation",
        "attachment",
        "availability",
        "capabilities"
      ],
      "additionalProperties": true
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "auth_required": {
          "type": "boolean"
        },
        "membership": {
          "enum": [
            "enrolled",
            "removed"
          ]
        },
        "selectable": {
          "type": "boolean"
        },
        "usage": {
          "type": "object"
        },
        "usage_fresh": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "enabled",
        "auth_required",
        "membership",
        "selectable",
        "usage",
        "usage_fresh"
      ],
      "additionalProperties": true
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "observed_at": {
          "type": "integer"
        },
        "account_source": {
          "enum": [
            "supervisor",
            "offline_snapshot",
            "uninitialized"
          ]
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Account"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        },
        "capabilities": {
          "type": "object"
        }
      },
      "required": [
        "observed_at",
        "account_source",
        "accounts",
        "sessions",
        "capabilities"
      ],
      "additionalProperties": true
    },
    "MessageRequest": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "submit",
            "queue",
            "resume"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "expires_at": {
          "type": "integer"
        },
        "recovery": {
          "oneOf": [
            {
              "$ref": "#/$defs/RecoveryIntent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "api_version",
        "message_id",
        "session_id",
        "expected_generation",
        "mode",
        "text",
        "expires_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "resume"
              }
            }
          },
          "then": {
            "required": [
              "recovery"
            ],
            "properties": {
              "recovery": {
                "$ref": "#/$defs/RecoveryIntent"
              }
            }
          },
          "else": {
            "properties": {
              "recovery": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted_generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "const": "codex"
        },
        "provider_conversation_id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "submit",
            "queue",
            "resume"
          ]
        },
        "delivery_semantics": {
          "const": "non_steering_native_queue"
        },
        "state": {
          "enum": [
            "pending_local",
            "native_accepted",
            "execution_started",
            "completed_with_reply",
            "delivery_unknown",
            "rejected",
            "failed",
            "cancelled",
            "expired",
            "launch_unknown"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "facts": {
          "$ref": "#/$defs/ReceiptFacts"
        },
        "reply": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PublicReply"
            }
          ]
        },
        "accepted_runtime_generation": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_queue_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "correlation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PublicCorrelation"
            }
          ]
        },
        "observation": {
          "$ref": "#/$defs/ReceiptObservation"
        },
        "launch": {
          "$ref": "#/$defs/RecoveryLaunchFacts"
        }
      },
      "required": [
        "message_id",
        "session_id",
        "accepted_generation",
        "provider",
        "provider_conversation_id",
        "mode",
        "delivery_semantics",
        "state",
        "reason",
        "facts",
        "reply",
        "accepted_runtime_generation",
        "native_queue_id",
        "correlation",
        "observation"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "resume"
              }
            }
          },
          "then": {
            "required": [
              "launch"
            ]
          },
          "else": {
            "properties": {
              "accepted_runtime_generation": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "Operation": {
      "type": "object",
      "required": [
        "id",
        "source_session_id",
        "kind",
        "phase",
        "detail",
        "confirmation_seq",
        "non_steering"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source_session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "confirmation_seq": {
          "type": "integer",
          "minimum": 0
        },
        "non_steering": {
          "const": true
        },
        "source_account_id": {
          "type": "string"
        },
        "target_account_id": {
          "type": "string"
        },
        "provider_conversation_id": {
          "type": "string"
        }
      }
    },
    "LauncherPlan": {
      "type": "object",
      "required": [
        "action",
        "argv",
        "cwd"
      ],
      "properties": {
        "action": {
          "const": "exec"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "credentials_in_client": {
          "const": false
        }
      }
    },
    "ActionHint": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "reason"
      ],
      "additionalProperties": true
    },
    "Readiness": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "const": "codex"
        },
        "provider_conversation_id": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "idle",
            "working",
            "interrupted",
            "errored",
            "disconnected",
            "unknown"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale"
          ]
        },
        "runtime_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "previous_turn_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "explicit_intent": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "stop_requested",
                "unknown"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "id"
          ],
          "additionalProperties": true
        },
        "queued_work_count": {
          "type": "null"
        },
        "evidence": {
          "const": "native_read_only_snapshot_not_reservation"
        },
        "delivery_semantics": {
          "const": "non_steering_native_queue"
        },
        "actions": {
          "type": "object",
          "properties": {
            "submit": {
              "$ref": "#/$defs/ActionHint"
            },
            "queue": {
              "$ref": "#/$defs/ActionHint"
            },
            "resume": {
              "$ref": "#/$defs/ActionHint"
            }
          },
          "required": [
            "submit",
            "queue"
          ],
          "additionalProperties": true
        },
        "observation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "fresh",
                "stale",
                "unobserved"
              ]
            },
            "checked_at": {
              "type": "integer"
            }
          },
          "required": [
            "status",
            "checked_at"
          ]
        },
        "runtime_state": {
          "type": "string"
        },
        "process_state": {
          "enum": [
            "running",
            "exited",
            "unattached",
            "unknown"
          ]
        },
        "process_observed_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "generation",
        "provider",
        "provider_conversation_id",
        "account_id",
        "state",
        "reason",
        "observed_at",
        "valid_until",
        "freshness",
        "runtime_generation",
        "previous_turn_id",
        "explicit_intent",
        "queued_work_count",
        "evidence",
        "delivery_semantics",
        "actions"
      ],
      "additionalProperties": true
    },
    "PublicCorrelation": {
      "type": "object",
      "properties": {
        "native_turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "original_input_item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "completion_input_item_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "observed_runtime_generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reply_item_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        }
      },
      "required": [
        "native_turn_id",
        "original_input_item_id",
        "completion_input_item_id",
        "observed_runtime_generation",
        "reply_item_id"
      ],
      "additionalProperties": true
    },
    "PublicReply": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "phase": {
          "enum": [
            "final_answer",
            null
          ]
        }
      },
      "required": [
        "item_id",
        "text",
        "phase"
      ],
      "additionalProperties": true
    },
    "ReceiptObservation": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_checked",
            "observed",
            "uncorrelated",
            "unavailable",
            "cached",
            "not_applicable"
          ]
        },
        "checked_at": {
          "type": "integer",
          "minimum": 0
        },
        "native_attempted_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidence_observed_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "checked_at",
        "native_attempted_at",
        "evidence_observed_at",
        "freshness",
        "error_code"
      ],
      "additionalProperties": true
    },
    "ReceiptFacts": {
      "type": "object",
      "properties": {
        "accepted_local": {
          "const": true
        },
        "accepted_native": {
          "type": "boolean"
        },
        "input_recorded": {
          "type": "boolean"
        },
        "input_consumed": {
          "const": "unknown"
        },
        "reply_observed": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted_local",
        "accepted_native",
        "input_recorded",
        "input_consumed",
        "reply_observed"
      ],
      "additionalProperties": true
    },
    "LaunchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "account_id",
        "name",
        "host",
        "space",
        "directory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "pattern": "^codex:[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "socket"
          ],
          "properties": {
            "session": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "socket": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "space": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "existing"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "label"
              ],
              "properties": {
                "kind": {
                  "const": "new"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "create",
            "confirmed_existing"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "create": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "confirmed_existing": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "LaunchReceipt": {
      "type": "object",
      "required": [
        "version",
        "request",
        "phase",
        "detail",
        "workspace_id",
        "tab_id",
        "pane_id",
        "conversation_id",
        "session_id",
        "generation",
        "created_directories",
        "updated_at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request": {
          "$ref": "#/$defs/LaunchRequest"
        },
        "phase": {
          "enum": [
            "admitted",
            "preparing",
            "creating_terminal",
            "dispatching",
            "starting_provider",
            "attached",
            "running",
            "failed",
            "uncertain"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
